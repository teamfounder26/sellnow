# ---------- Core ----------
# Public base URL used for redirects, webhooks and storefront links
APP_URL=http://localhost:3000
# 32-byte base64 key used to encrypt stored integration secrets (AES-256-GCM). REQUIRED in production.
APP_ENCRYPTION_KEY=
# HMAC secret for signed download links & dev test gateway. REQUIRED in production.
APP_SIGNING_SECRET=

# ---------- Database ----------
# PostgreSQL connection string. If unset (development only), an embedded PGlite Postgres is used at ./.data/pglite
DATABASE_URL=
# Development only: alternative embedded database folder (e.g. a second, isolated dev server)
PGLITE_DIR=

# ---------- AI (TokenPortal — primary) ----------
# OpenAI-compatible provider (https://tokenportal.id/docs/curl). Server-side only — never expose or commit the key.
# If a key was ever pasted into chat, a ticket or a repo, rotate it in the TokenPortal dashboard.
TOKENPORTAL_API_KEY=
TOKENPORTAL_BASE_URL=https://tokenportal.id/v1
TOKENPORTAL_MODEL=gpt-6.1-sol
# Optional: request timeout (ms), "false" if the model is not vision-tagged, "json_object" for json-tagged models
TOKENPORTAL_TIMEOUT_MS=
TOKENPORTAL_VISION=
TOKENPORTAL_JSON_MODE=
# Optional: "true" sends instructions as a system message (measured to cost ~5x more prompt tokens on TokenPortal)
TOKENPORTAL_SYSTEM_ROLE=
# Optional: per-million-token USD prices to record estimated cost per generation
TOKENPORTAL_PRICE_IN_USD_PER_MTOK=
TOKENPORTAL_PRICE_OUT_USD_PER_MTOK=

# ---------- Speech-to-text (voice notes) ----------
# Any OpenAI-compatible /audio/transcriptions service (Whisper-class). TokenPortal does not document audio.
# Unset = sellers can still record & play back, then type what they said.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ---------- Sign-in with Google / Facebook (OAuth 2.0 + PKCE) ----------
# Redirect URIs to register: {APP_URL}/api/auth/google/callback and {APP_URL}/api/auth/facebook/callback
# Facebook Login grants identity only (email, public_profile) — NOT Pages/Ads access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- AI (Anthropic — fallback) ----------
# Used only when TOKENPORTAL_API_KEY is unset. With neither key, SellNow runs in "manual" mode.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
SELLNOW_AI_MODEL=
# Optional: override API base URL (default https://api.anthropic.com)
SELLNOW_ANTHROPIC_BASE_URL=

# ---------- Email ----------
# Not implemented yet beyond the console adapter. In development, verification links are printed to the server log.
EMAIL_FROM=

# ---------- Payments ----------
# Merchant credentials (Stripe secret key / webhook secret, Billplz API key / X-Signature key)
# are entered per workspace in Settings → Payments and stored encrypted. No global keys are needed.
# Set to "true" to allow the no-money Test Gateway outside development (never in real production).
ALLOW_TEST_GATEWAY=

# ---------- Meta Ads (AI Ads Studio) ----------
# A Meta app with Marketing API access (ads_management, ads_read, business_management, pages_show_list,
# pages_read_engagement, instagram_basic) approved via Meta App Review. Redirect URI to register:
#   {APP_URL}/api/integrations/meta/callback
# Without these, Ads Studio runs in Draft / Preview / Export mode and never claims a publish.
META_APP_ID=
META_APP_SECRET=
# AI Ads Studio promotional price in sen (default 15000 = RM150/month). Software fee only — Meta bills ad spend.
ADS_STUDIO_PRICE_SEN=
# Scheduled performance sync: POST /api/cron/ads-sync with header x-cron-key: $CRON_SECRET (every 1–3 h)

# AI Poster Studio image generation (OpenAI-compatible /images/generations). TokenPortal has no image
# models, so this is a separate provider. Without it, briefs, prompts and layout posters still work.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_PROVIDER_NAME=
IMAGE_TIMEOUT_MS=

# ---- V3 commerce -----------------------------------------------------------------------------
# Selltro Pay (Billplz Enterprise, platform-managed — sellers never see these).
# test = simulated (no money, default outside production) | sandbox | live (live also needs the
# Superadmin "Live Selltro Pay approved" switch after the contract/KYC model is confirmed).
SELLTRO_PAY_MODE=
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_ID=
# Payment Order (disbursement) collection. Payouts also need the Superadmin "Real payouts" switch.
BILLPLZ_PAYMENT_ORDER_COLLECTION_ID=
# ParcelDaily (platform-managed courier account). Webhook secret is REQUIRED (unsigned hooks refused).
PARCELDAILY_ENV=sandbox
PARCELDAILY_TOKEN=
PARCELDAILY_MERCHANT_ID=
PARCELDAILY_WEBHOOK_SECRET=
# First Superadmin: the user with this email becomes platform owner on first visit to /admin
# (only while no admin exists). Or: npx tsx --conditions=react-server scripts/grant-admin.ts <email> owner
SUPERADMIN_BOOTSTRAP_EMAIL=
